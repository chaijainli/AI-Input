<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="240dp"
    android:orientation="vertical"
    android:background="#22C55E"
    android:paddingBottom="4dp">

    <com.aikb.ime.ui.CandidateStrip
        android:id="@+id/candidate_strip"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_margin="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:orientation="horizontal" android:weightSum="10">
            <Button android:id="@+id/key_q" style="@style/KeyStyle" android:layout_weight="1" android:text="Q" />
            <Button android:id="@+id/key_w" style="@style/KeyStyle" android:layout_weight="1" android:text="W" />
            <Button android:id="@+id/key_e" style="@style/KeyStyle" android:layout_weight="1" android:text="E" />
            <Button android:id="@+id/key_r" style="@style/KeyStyle" android:layout_weight="1" android:text="R" />
            <Button android:id="@+id/key_t" style="@style/KeyStyle" android:layout_weight="1" android:text="T" />
            <Button android:id="@+id/key_y" style="@style/KeyStyle" android:layout_weight="1" android:text="Y" />
            <Button android:id="@+id/key_u" style="@style/KeyStyle" android:layout_weight="1" android:text="U" />
            <Button android:id="@+id/key_i" style="@style/KeyStyle" android:layout_weight="1" android:text="I" />
            <Button android:id="@+id/key_o" style="@style/KeyStyle" android:layout_weight="1" android:text="O" />
            <Button android:id="@+id/key_p" style="@style/KeyStyle" android:layout_weight="1" android:text="P" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:orientation="horizontal" android:weightSum="9"
            android:paddingStart="4dp" android:paddingEnd="4dp">
            <Button android:id="@+id/key_a" style="@style/KeyStyle" android:layout_weight="1" android:text="A" />
            <Button android:id="@+id/key_s" style="@style/KeyStyle" android:layout_weight="1" android:text="S" />
            <Button android:id="@+id/key_d" style="@style/KeyStyle" android:layout_weight="1" android:text="D" />
            <Button android:id="@+id/key_f" style="@style/KeyStyle" android:layout_weight="1" android:text="F" />
            <Button android:id="@+id/key_g" style="@style/KeyStyle" android:layout_weight="1" android:text="G" />
            <Button android:id="@+id/key_h" style="@style/KeyStyle" android:layout_weight="1" android:text="H" />
            <Button android:id="@+id/key_j" style="@style/KeyStyle" android:layout_weight="1" android:text="J" />
            <Button android:id="@+id/key_k" style="@style/KeyStyle" android:layout_weight="1" android:text="K" />
            <Button android:id="@+id/key_l" style="@style/KeyStyle" android:layout_weight="1" android:text="L" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:orientation="horizontal" android:weightSum="12"
            android:paddingStart="4dp" android:paddingEnd="4dp">
            <Button android:id="@+id/key_shift" style="@style/KeyStyle"
                android:layout_weight="2" android:text="CAPS" android:textSize="12sp" />
            <Button android:id="@+id/key_z" style="@style/KeyStyle" android:layout_weight="1" android:text="Z" />
            <Button android:id="@+id/key_x" style="@style/KeyStyle" android:layout_weight="1" android:text="X" />
            <Button android:id="@+id/key_c" style="@style/KeyStyle" android:layout_weight="1" android:text="C" />
            <Button android:id="@+id/key_v" style="@style/KeyStyle" android:layout_weight="1" android:text="V" />
            <Button android:id="@+id/key_b" style="@style/KeyStyle" android:layout_weight="1" android:text="B" />
            <Button android:id="@+id/key_n" style="@style/KeyStyle" android:layout_weight="1" android:text="N" />
            <Button android:id="@+id/key_m" style="@style/KeyStyle" android:layout_weight="1" android:text="M" />
            <Button android:id="@+id/key_delete" style="@style/KeyStyle"
                android:layout_weight="2" android:text="DEL" android:textColor="#F87171" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:orientation="horizontal" android:weightSum="4.5">
            <Button android:id="@+id/key_space" style="@style/KeyStyle"
                android:layout_weight="1.5" android:text="SPACE" android:textSize="12sp" android:textColor="#94A3B8" />
            <Button android:id="@+id/key_send" style="@style/KeyStyle"
                android:layout_weight="1" android:text="SEND" android:background="#16A34A" android:textColor="#FFFFFF" />
            <Button android:id="@+id/key_emoji" style="@style/KeyStyle"
                android:layout_weight="1" android:text="Aa" android:textSize="14sp" />
            <Button android:id="@+id/key_settings" style="@style/KeyStyle"
                android:layout_weight="1" android:text="SET" android:textSize="14sp" android:textColor="#FBBF24" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>